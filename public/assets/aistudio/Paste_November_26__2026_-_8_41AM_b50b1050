+-- ---------------------------------------------------------------------
+-- 6) أرقام الملاك: جدول خاص + كشف محدود المعدل
+-- ---------------------------------------------------------------------
+alter table public.chalet_contacts alter column owner_id drop not null;
+
+-- نقل الأرقام الحالية من chalets.owner_phone (إن وُجد العمود) قبل حذفه
+do $$
+begin
+  if exists (select 1 from information_schema.columns
+              where table_schema = 'public' and table_name = 'chalets' and column_name = 'owner_phone') then
+    insert into public.chalet_contacts (chalet_id, owner_id, owner_phone)
+    select c.id, c.owner_id, btrim(c.owner_phone)
+      from public.chalets c
+     where c.owner_phone is not null and btrim(c.owner_phone) <> ''
+    on conflict (chalet_id) do nothing;
+
+    alter table public.chalets drop column owner_phone;
+  end if;
+end $$;
+
+create or replace function public.chalet_contacts_before()
+returns trigger
+language plpgsql
+security definer
+set search_path = public
+as $$
+begin
+  new.owner_id := (select c.owner_id from public.chalets c where c.id = new.chalet_id);
+  new.owner_phone := btrim(new.owner_phone);
+  if new.owner_phone !~ '^01[0125][0-9]{8}$' then
+    raise exception 'phone_invalid';
+  end if;
+  return new;
+end;
+$$;
+
+drop trigger if exists trg_chalet_contacts_before on public.chalet_contacts;
+create trigger trg_chalet_contacts_before
+  before insert or update on public.chalet_contacts
+  for each row when (public.is_privileged_session() is not true)
+  execute function public.chalet_contacts_before();
+
+do $$
+declare
+  pol record;
+begin
+  for pol in select policyname from pg_policies where schemaname = 'public' and tablename = 'chalet_contacts' loop
+    execute format('drop policy %I on public.chalet_contacts', pol.policyname);
+  end loop;
