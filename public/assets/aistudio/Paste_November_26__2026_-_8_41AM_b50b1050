+import { describe, expect, it } from 'vitest';
+import { SUBSCRIPTION_PLANS } from '@/data/subscriptions';
+import sql from '../../../supabase/migrations/006_secure_v2.sql?raw';
+
+/**
+ * الباقات معرّفة مرتين: في الواجهة (للعرض) وفي قاعدة البيانات (المرجع الفعلي للسعر والحد).
+ * هذا الاختبار يمنع تباعدهما: أي تعديل في أحدهما بلا الآخر يفشل البناء.
+ */
+describe('تطابق الباقات بين الواجهة وملف 006_secure_v2.sql', () => {
+  const block = sql.slice(sql.indexOf('insert into public.plans'), sql.indexOf('on conflict (id) do update'));
+
+  const rows = [...block.matchAll(/\('(\w+)',\s*'[^']*',\s*(\d+),\s*(\d+),\s*(true|false),\s*(\d+),\s*(\d+)\)/g)].map(
+    (m) => ({ id: m[1], price: Number(m[2]), maxUnits: Number(m[3]), featured: m[4] === 'true' })
+  );
+
+  it('تحتوي الهجرة على نفس عدد الباقات', () => {
+    expect(rows).toHaveLength(SUBSCRIPTION_PLANS.length);
+  });
+
+  it.each(SUBSCRIPTION_PLANS)('الباقة $id: السعر والسعة والشارة متطابقة', (plan) => {
+    const row = rows.find((r) => r.id === plan.id);
+    expect(row, `الباقة ${plan.id} غير موجودة في SQL`).toBeDefined();
+    expect(row?.price).toBe(plan.price);
+    expect(row?.maxUnits).toBe(plan.maxUnits);
+    expect(row?.featured).toBe(plan.isFeaturedEligible);
+  });
+});
