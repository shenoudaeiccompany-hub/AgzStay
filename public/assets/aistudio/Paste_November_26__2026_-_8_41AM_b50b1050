+-- حماية الأعمدة المُدارة من النظام (تتجاهل ما يرسله العميل بصمت، وتفرض الحد)
+create or replace function public.chalets_protect()
+returns trigger
+language plpgsql
+security definer
+set search_path = public
+as $$
+begin
+  if public.is_privileged_session() or pg_trigger_depth() > 1 then
+    return new;
+  end if;
+
+  if tg_op = 'INSERT' then
+    new.owner_id := auth.uid();
+    if new.owner_id is null then raise exception 'not_authenticated'; end if;
+
+    new.is_featured := public.owner_featured_eligible(new.owner_id);
+    new.featured := false;
+    new.rating := 0;
+    new.reviews_count := 0;
+    new.owner_verified := false;
+    new.host_tier := 'free';
+    new.verified_live_photos := false;
+    new.live_photos_verified_at := null;
+    if new.availability_status = 'suspended' then raise exception 'forbidden_status'; end if;
+
+    if (select count(*) from public.chalets c where c.owner_id = new.owner_id)
+         >= public.owner_max_units(new.owner_id) then
+      raise exception 'quota_exceeded';
+    end if;
+  else
+    new.owner_id := old.owner_id;
+    new.is_featured := old.is_featured;
+    new.featured := old.featured;
+    new.rating := old.rating;
+    new.reviews_count := old.reviews_count;
+    new.owner_verified := old.owner_verified;
+    new.host_tier := old.host_tier;
+    new.verified_live_photos := old.verified_live_photos;
+    new.live_photos_verified_at := old.live_photos_verified_at;
+
+    if old.availability_status = 'suspended' and new.availability_status <> 'suspended' then
+      raise exception 'listing_suspended';
+    end if;
+    if new.availability_status = 'suspended' and old.availability_status <> 'suspended' then
+      raise exception 'forbidden_status';
+    end if;
+  end if;
+  return new;
+end;
+$$;
+
+drop trigger if exists trg_a_chalets_protect on public.chalets;
+create trigger trg_a_chalets_protect
+  before insert or update on public.chalets
+  for each row execute function public.chalets_protect();
+
+-- بوابة النشر: التوثيق اختياري افتراضياً (شارة فقط)، ويمكن إلزامه من app_settings
+create or replace function public.enforce_chalet_verified_owner_publish()
+returns trigger
+language plpgsql
+security definer
+set search_path = public, extensions
+as $$
+declare
+  v_verified boolean;
+begin
+  if public.is_privileged_session() then
+    return new;
+  end if;
+
+  select exists (
+    select 1 from public.owner_verifications ov
+     where ov.owner_id = new.owner_id and ov.status = 'verified'
+  ) into v_verified;
+
+  new.owner_verified := coalesce(v_verified, false);
+
+  if not coalesce(v_verified, false)
+     and new.availability_status = 'active'
+     and public.app_setting('require_verified_to_publish', 'false') = 'true' then
+    new.availability_status := 'pending_review';
+  end if;
+
+  return new;
+end;
+$$;
