+  to authenticated
+  using (exists (select 1 from public.chalets c
+                  where c.id = chalet_contacts.chalet_id and (c.owner_id = auth.uid() or public.is_admin())))
+  with check (exists (select 1 from public.chalets c
+                       where c.id = chalet_contacts.chalet_id and (c.owner_id = auth.uid() or public.is_admin())));
+
+revoke all on public.chalet_contacts from anon, authenticated;
+grant select, insert, update, delete on public.chalet_contacts to authenticated;
