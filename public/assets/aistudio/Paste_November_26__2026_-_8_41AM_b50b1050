+-- الباقة الفعّالة لمالك (الاشتراك المدفوع غير المنتهي الأعلى سعة، وإلا المجانية)
+create or replace function public.owner_plan(p_owner uuid)
+returns public.plans
+language plpgsql
+stable
+security definer
+set search_path = public
+as $$
+declare
+  r public.plans;
+begin
+  select p.* into r
+    from public.subscriptions s
+    join public.plans p on p.id = s.plan_id
+   where s.owner_id = p_owner
+     and s.status = 'active'
+     and (s.expires_at is null or s.expires_at > now())
+   order by p.max_units desc
+   limit 1;
+
+  if not found then
+    select * into r from public.plans where id = 'free';
+  end if;
+  return r;
+end;
+$$;
+
+create or replace function public.owner_max_units(p_owner uuid)
+returns integer
+language sql
+stable
+security definer
+set search_path = public
+as $$ select (public.owner_plan(p_owner)).max_units $$;
+
+create or replace function public.owner_featured_eligible(p_owner uuid)
+returns boolean
+language sql
