+-- طلب اشتراك مدفوع: السعر والسعة يؤخذان من جدول plans لا من العميل
+create or replace function public.request_subscription(p_plan_id text, p_receipt_path text default null)
+returns public.subscriptions
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_uid  uuid := auth.uid();
+  v_plan public.plans;
+  v_prof public.profiles;
+  v_sub  public.subscriptions;
+begin
+  if v_uid is null then raise exception 'not_authenticated'; end if;
+
+  select * into v_plan from public.plans where id = p_plan_id;
+  if not found then raise exception 'invalid_plan'; end if;
+  if v_plan.price = 0 then raise exception 'plan_is_free'; end if;
+
+  if p_receipt_path is null or p_receipt_path not like v_uid::text || '/%' then
+    raise exception 'invalid_receipt_path';
+  end if;
+
+  if exists (select 1 from public.subscriptions s where s.owner_id = v_uid and s.status = 'pending') then
+    raise exception 'duplicate_request';
+  end if;
+
+  select * into v_prof from public.profiles where id = v_uid;
+
+  insert into public.subscriptions
+    (owner_id, owner_name, owner_phone, plan_id, plan_name, price, max_units, receipt_path, status)
+  values
+    (v_uid, coalesce(nullif(btrim(v_prof.name), ''), 'معلن AgzStay'), coalesce(v_prof.phone, ''),
+     v_plan.id, v_plan.name, v_plan.price, v_plan.max_units, p_receipt_path, 'pending')
+  returning * into v_sub;
+
+  return v_sub;
+end;
+$$;
+
+-- مراجعة المدير: تفعيل أو رفض (التفعيل يستبدل أي باقة سابقة فوراً ويحدّث الشارة)
+create or replace function public.admin_review_subscription(
+  p_id text, p_approve boolean, p_note text default null
+)
+returns public.subscriptions
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_sub  public.subscriptions;
+  v_plan public.plans;
+begin
+  if not public.is_admin() then raise exception 'forbidden'; end if;
+
+  select * into v_sub from public.subscriptions where id = p_id for update;
+  if not found then raise exception 'not_found'; end if;
+  if v_sub.status <> 'pending' then raise exception 'invalid_state'; end if;
+
+  if p_approve then
+    if v_sub.owner_id is null then raise exception 'owner_missing'; end if;
+    select * into v_plan from public.plans where id = v_sub.plan_id;
+
+    update public.subscriptions set status = 'expired'
+     where owner_id = v_sub.owner_id and status = 'active';
+
+    update public.subscriptions
+       set status = 'active', reviewed_at = now(),
+           expires_at = now() + make_interval(days => v_plan.duration_days),
+           review_note = left(p_note, 300)
+     where id = p_id
+     returning * into v_sub;
+  else
+    update public.subscriptions
+       set status = 'rejected', reviewed_at = now(), review_note = left(p_note, 300)
+     where id = p_id
+     returning * into v_sub;
+  end if;
+
+  if v_sub.owner_id is not null then
+    perform public.refresh_owner_featured(v_sub.owner_id);
+  end if;
+  return v_sub;
+end;
+$$;
+
+-- للجدولة (pg_cron): إنهاء الاشتراكات المنتهية وإزالة الشارة
+create or replace function public.expire_subscriptions()
+returns integer
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  r record;
+  n integer := 0;
+begin
+  for r in
+    update public.subscriptions
+       set status = 'expired'
+     where status = 'active' and expires_at is not null and expires_at <= now()
+     returning owner_id
+  loop
+    n := n + 1;
+    if r.owner_id is not null then perform public.refresh_owner_featured(r.owner_id); end if;
+  end loop;
+  return n;
+end;
+$$;
+
+-- ملخص اشتراك المستخدم الحالي للوحة المالك
+create or replace function public.my_subscription()
+returns jsonb
+language plpgsql
+stable
+security definer
+set search_path = public
+as $$
+declare
+  v_uid  uuid := auth.uid();
+  v_plan public.plans;
+  v_exp  timestamptz;
+  v_pend public.subscriptions;
+begin
+  if v_uid is null then raise exception 'not_authenticated'; end if;
+  v_plan := public.owner_plan(v_uid);
+
+  select max(s.expires_at) into v_exp
+    from public.subscriptions s
+   where s.owner_id = v_uid and s.status = 'active' and s.plan_id = v_plan.id;
+
+  select * into v_pend from public.subscriptions s
+   where s.owner_id = v_uid and s.status = 'pending' limit 1;
+
+  return jsonb_build_object(
+    'plan_id', v_plan.id,
+    'plan_name', v_plan.name,
+    'max_units', v_plan.max_units,
+    'featured_eligible', v_plan.featured_eligible,
+    'used_units', (select count(*) from public.chalets c where c.owner_id = v_uid),
+    'expires_at', case when v_plan.id = 'free' then null else v_exp end,
+    'pending_request', case when v_pend.id is null then null
+                            else jsonb_build_object('id', v_pend.id, 'plan_id', v_pend.plan_id) end
+  );
+end;
+$$;
