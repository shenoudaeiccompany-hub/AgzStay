+-- هوية المستدعي: مستخدم مسجّل أو عنوان IP (من ترويسات PostgREST)
+create or replace function public.client_actor()
+returns text
+language plpgsql
+stable
+security definer
+set search_path = public
+as $$
+declare
+  h  json;
+  ip text;
+begin
+  if auth.uid() is not null then
+    return 'u:' || auth.uid()::text;
+  end if;
+  begin
+    h := nullif(current_setting('request.headers', true), '')::json;
+  exception when others then
+    h := null;
+  end;
+  ip := btrim(split_part(coalesce(h ->> 'x-forwarded-for', h ->> 'cf-connecting-ip', ''), ',', 1));
+  return 'ip:' || coalesce(nullif(ip, ''), 'unknown');
+end;
+$$;
+revoke all on function public.client_actor() from public, anon, authenticated;
+
+create or replace function public.reveal_listing_contact(p_chalet_id text)
+returns text
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_actor text := public.client_actor();
+  v_limit integer := coalesce(nullif(public.app_setting('contact_reveal_limit_per_hour', '40'), '')::integer, 40);
+  v_phone text;
+begin
+  if not exists (select 1 from public.chalets c
+                  where c.id = p_chalet_id and c.availability_status in ('active', 'rented')) then
+    raise exception 'chalet_not_found';
+  end if;
+
+  if (select count(*) from public.contact_reveals r
+       where r.actor = v_actor and r.created_at > now() - interval '1 hour') >= v_limit then
+    raise exception 'rate_limited';
+  end if;
+
+  select cc.owner_phone into v_phone from public.chalet_contacts cc where cc.chalet_id = p_chalet_id;
+  if v_phone is null then raise exception 'contact_not_available'; end if;
+
+  insert into public.contact_reveals (actor, chalet_id) values (v_actor, p_chalet_id);
+  return v_phone;
+end;
+$$;
+
+create or replace function public.purge_contact_reveals()
+returns integer
+language sql
+security definer
+set search_path = public
+as $$
+  with d as (delete from public.contact_reveals where created_at < now() - interval '30 days' returning 1)
+  select count(*)::integer from d;
+$$;
+revoke all on function public.purge_contact_reveals() from public, anon, authenticated;
+
+-- ---------------------------------------------------------------------
+-- 7) ربط الإعلانات والاشتراكات القديمة (جلسة هاتف) بحساب حقيقي — بقرار المدير
+-- ---------------------------------------------------------------------
+-- المدير يتحقق من الهاتف خارج النظام (اتصال/واتساب) ثم ينفّذ:
+--   select public.admin_link_legacy_owner('<user uuid>', '01012345678');
+create or replace function public.admin_link_legacy_owner(p_user uuid, p_phone text)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_chalets integer;
+  v_subs    integer := 0;
+  r         record;
+begin
+  if not public.is_admin() and not public.is_privileged_session() then raise exception 'forbidden'; end if;
+  if not exists (select 1 from public.profiles where id = p_user) then raise exception 'not_found'; end if;
+
+  update public.chalets c set owner_id = p_user
+   where c.owner_id is null
+     and c.id in (select cc.chalet_id from public.chalet_contacts cc where cc.owner_phone = btrim(p_phone));
+  get diagnostics v_chalets = row_count;
+
+  update public.chalet_contacts set owner_id = p_user
+   where owner_id is null and owner_phone = btrim(p_phone);
+
+  -- الاشتراكات القديمة: طلب معلّق واحد فقط لكل مالك (الأحدث يبقى، والباقي يُرفض كمستبدَل)
+  for r in
+    select s.id, s.status from public.subscriptions s
+     where s.owner_id is null and s.owner_phone = btrim(p_phone)
+     order by s.created_at desc
+  loop
+    if r.status = 'pending'
+       and exists (select 1 from public.subscriptions x where x.owner_id = p_user and x.status = 'pending') then
+      update public.subscriptions
+         set owner_id = p_user, status = 'rejected', reviewed_at = now(),
+             review_note = 'استُبدل بطلب أحدث عند ربط الحساب'
+       where id = r.id;
+    else
+      update public.subscriptions set owner_id = p_user where id = r.id;
+    end if;
+    v_subs := v_subs + 1;
+  end loop;
+
+  perform public.refresh_owner_featured(p_user);
+  return jsonb_build_object('chalets_linked', v_chalets, 'subscriptions_linked', v_subs);
+end;
+$$;
+
+-- ---------------------------------------------------------------------
+-- 8) الصلاحيات على جدول chalets
+-- ---------------------------------------------------------------------
+revoke all on public.chalets from anon, authenticated;
+grant select on public.chalets to anon, authenticated;
+grant insert, update, delete on public.chalets to authenticated;
+
+-- ---------------------------------------------------------------------
+-- 9) التخزين: صور الإعلانات عامة للقراءة، والإيصالات خاصة، والكتابة داخل مجلد المستخدم
+-- ---------------------------------------------------------------------
+update storage.buckets set public = false where id = 'receipts';
+
+drop policy if exists property_images_v2_select on storage.objects;
+drop policy if exists property_images_v2_insert on storage.objects;
+drop policy if exists property_images_v2_delete on storage.objects;
+drop policy if exists receipts_v2_select on storage.objects;
+drop policy if exists receipts_v2_insert on storage.objects;
+drop policy if exists property_images_select_own on storage.objects;
+drop policy if exists property_images_insert_own on storage.objects;
+drop policy if exists property_images_update_own on storage.objects;
+drop policy if exists property_images_delete_own on storage.objects;
+drop policy if exists receipts_select_own_or_admin on storage.objects;
+drop policy if exists receipts_insert_own on storage.objects;
+
+-- الصور: القراءة العامة تعمل عبر الرابط العام للـ bucket؛ هذه السياسات للإدارة والكتابة فقط
+create policy property_images_select_own on storage.objects for select to authenticated
+  using (bucket_id = 'property-images'
+         and ((storage.foldername(name))[1] = auth.uid()::text or public.is_admin()));
+create policy property_images_insert_own on storage.objects for insert to authenticated
+  with check (bucket_id = 'property-images' and (storage.foldername(name))[1] = auth.uid()::text);
+create policy property_images_update_own on storage.objects for update to authenticated
+  using (bucket_id = 'property-images' and (storage.foldername(name))[1] = auth.uid()::text)
+  with check (bucket_id = 'property-images' and (storage.foldername(name))[1] = auth.uid()::text);
+create policy property_images_delete_own on storage.objects for delete to authenticated
+  using (bucket_id = 'property-images'
+         and ((storage.foldername(name))[1] = auth.uid()::text or public.is_admin()));
+
+-- الإيصالات: خاصة. يرفع صاحبها داخل مجلده، ويقرؤها هو والمدير فقط، ولا تعديل ولا حذف
+create policy receipts_insert_own on storage.objects for insert to authenticated
+  with check (bucket_id = 'receipts' and (storage.foldername(name))[1] = auth.uid()::text);
+create policy receipts_select_own_or_admin on storage.objects for select to authenticated
+  using (bucket_id = 'receipts'
+         and ((storage.foldername(name))[1] = auth.uid()::text or public.is_admin()));
+
+-- ---------------------------------------------------------------------
+-- 10) صلاحيات تنفيذ الدوال
+-- ---------------------------------------------------------------------
+revoke all on function public.request_subscription(text, text)           from public, anon, authenticated;
+revoke all on function public.admin_review_subscription(text, boolean, text) from public, anon, authenticated;
+revoke all on function public.expire_subscriptions()                      from public, anon, authenticated;
+revoke all on function public.my_subscription()                           from public, anon, authenticated;
+revoke all on function public.reveal_listing_contact(text)                from public, anon, authenticated;
+revoke all on function public.admin_link_legacy_owner(uuid, text)         from public, anon, authenticated;
+
+grant execute on function public.request_subscription(text, text)            to authenticated;
+grant execute on function public.admin_review_subscription(text, boolean, text) to authenticated;  -- الدالة نفسها تفحص is_admin()
+grant execute on function public.my_subscription()                           to authenticated;
+grant execute on function public.reveal_listing_contact(text)                to anon, authenticated;
+grant execute on function public.admin_link_legacy_owner(uuid, text)         to authenticated;  -- تفحص is_admin()
+
+-- ---------------------------------------------------------------------
+-- 11) الجدولة (اختياري): فعّل pg_cron من Dashboard > Database > Extensions ثم شغّل:
+-- ---------------------------------------------------------------------
+-- select cron.schedule('agzstay-expire-subscriptions', '0 * * * *', $$ select public.expire_subscriptions(); $$);
+-- select cron.schedule('agzstay-purge-reveals',        '30 3 * * *', $$ select public.purge_contact_reveals(); $$);
+
+-- ---------------------------------------------------------------------
+-- 12) تقرير مراجعة (آخر نتيجة تظهر في SQL Editor): ما يجب فحصه يدوياً بعد التنفيذ
+-- ---------------------------------------------------------------------
+select * from (
+  select 'admin_to_review' as kind, p.id::text as ref, coalesce(p.name, '') as detail
+    from public.profiles p where p.role = 'admin'
+  union all
+  select 'open_policy_remaining', pol.tablename || '.' || pol.policyname, pol.cmd
+    from pg_policies pol
+   where pol.schemaname in ('public', 'storage')
+     and (pol.qual = 'true' or pol.with_check = 'true')
+     and pol.tablename not in ('plans')
+  union all
+  select 'legacy_listing_without_owner', c.id, c.title from public.chalets c where c.owner_id is null
+  union all
+  select 'legacy_subscription_without_owner', s.id, s.owner_name from public.subscriptions s where s.owner_id is null
+) report order by kind, ref;
+
+commit;
diff --git a/supabase/tests/006_security_tests.sql b/supabase/tests/006_security_tests.sql
new file mode 100644
index 0000000..cfc1549
--- /dev/null
+++ b/supabase/tests/006_security_tests.sql
@@ -0,0 +1,552 @@
+-- =====================================================================
+-- AgzStay — اختبارات الأمان لـ 006_secure_v2.sql
+--
+-- ⚠️ شغّله على مشروع staging/تجريبي فقط (ينشئ مستخدمين وهميين داخل معاملة).
+--    ينتهي بـ ROLLBACK فلا يترك أي بيانات. أي فشل يوقفه برسالة FAIL توضح السبب.
+-- يفترض تطبيق 001 ثم 005 ثم 006 (بهذا الترتيب).
+-- =====================================================================
+
+begin;
+
+-- ---------- أدوات الاختبار (تُحذف مع ROLLBACK) ----------
+create schema t;
+grant usage on schema t to public;
+create table t.state (k text primary key, v text);
+grant all on t.state to public;
+
+create function t.as_user(p_uid uuid) returns void language plpgsql as $$
+begin
+  execute 'reset role';
+  perform set_config('request.jwt.claims', json_build_object('sub', p_uid, 'role', 'authenticated')::text, true);
+  perform set_config('request.headers', '{}', true);
+  execute 'set local role authenticated';
+end $$;
+
+create function t.as_anon(p_ip text default null) returns void language plpgsql as $$
+begin
+  execute 'reset role';
+  perform set_config('request.jwt.claims', '', true);
+  perform set_config('request.headers',
+    case when p_ip is null then '{}' else json_build_object('x-forwarded-for', p_ip || ', 10.0.0.1')::text end, true);
+  execute 'set local role anon';
+end $$;
+
+create function t.as_super() returns void language plpgsql as $$
+begin
+  execute 'reset role';
+end $$;
+
+create function t.ok(cond boolean, msg text) returns void language plpgsql as $$
+begin
+  if cond is not true then raise exception 'FAIL: %', msg; end if;
+  raise notice 'PASS: %', msg;
+end $$;
+
+create function t.fails(p_sql text, p_expect text, p_msg text) returns void language plpgsql as $$
+begin
+  begin
+    execute p_sql;
+  exception when others then
+    if sqlerrm ilike '%' || p_expect || '%' then
+      raise notice 'PASS: %', p_msg;
+      return;
+    end if;
+    raise exception 'FAIL: % (توقعت خطأ يحتوي "%" لكن الخطأ: %)', p_msg, p_expect, sqlerrm;
+  end;
+  raise exception 'FAIL: % (لم يحدث أي خطأ)', p_msg;
+end $$;
+
+-- إنشاء إعلان كمستخدم حالي. p_hostile=true يحاول فرض أعمدة محمية وملكية مستخدم آخر
+create function t.listing(p_title text, p_hostile boolean default false, p_status text default 'active')
+returns text language plpgsql as $$
+declare v_id text;
+begin
+  if p_hostile then
+    insert into public.chalets (title, price_per_night, owner_name, availability_status,
+                                owner_id, is_featured, featured, rating, reviews_count, owner_verified, host_tier)
+    values (p_title, 1000, 'مالك', p_status,
+            '00000000-0000-0000-0000-0000000000c2', true, true, 5, 99, true, 'pro')
+    returning id into v_id;
+  else
+    insert into public.chalets (title, price_per_night, owner_name, availability_status)
+    values (p_title, 1000, 'مالك', p_status)
+    returning id into v_id;
+    if p_status <> 'active' then
+      update public.chalets set availability_status = p_status where id = v_id;
+    end if;
+  end if;
+  return v_id;
+end $$;
+
+-- مستخدمون ثابتون: O1/O2/O3 ملاك، A مدير
+do $$
+begin
+  insert into auth.users (id, email, raw_user_meta_data) values
+    ('00000000-0000-0000-0000-0000000000c1', 'o1@test.dev', '{"name":"المالك الأول","role":"admin"}'),  -- محاولة تزوير الدور
+    ('00000000-0000-0000-0000-0000000000c2', 'o2@test.dev', '{"name":"المالك الثاني"}'),
+    ('00000000-0000-0000-0000-0000000000c3', 'o3@test.dev', '{"name":"المالك الثالث"}'),
+    ('00000000-0000-0000-0000-0000000000c4', 'admin@test.dev', '{"name":"المدير"}');
+  update public.profiles set role = 'admin' where id = '00000000-0000-0000-0000-0000000000c4';
+
+  -- بيانات قديمة تحاكي بوابة الهاتف: إعلانان بلا مالك ورقم في جدول الاتصال واشتراك معلّق
+  insert into public.chalets (id, title, price_per_night, owner_name, availability_status)
+  values ('legacy-t1', 'شاليه قديم', 1200, 'معلن قديم', 'active'),
+         ('legacy-t2', 'شقة قديمة مخفية', 700, 'معلن قديم', 'hidden');
+  insert into public.chalet_contacts (chalet_id, owner_id, owner_phone)
+  values ('legacy-t1', null, '01099990000'), ('legacy-t2', null, '01099990000');
+  insert into public.subscriptions (id, owner_name, owner_phone, plan_id, plan_name, price, max_units, status)
+  values ('sub-legacy-t1', 'معلن قديم', '01099990000', 'starter', 'باقة البداية', 500, 5, 'pending');
+end $$;
+
+-- =====================================================================
+-- 1) تصعيد الصلاحيات (الثغرة الحرجة): لا admin ذاتي
+-- =====================================================================
+do $$
+declare
+  o1 uuid := '00000000-0000-0000-0000-0000000000c1';
+  a  uuid := '00000000-0000-0000-0000-0000000000c4';
+begin
+  perform t.ok((select role from public.profiles where id = o1) = 'guest',
+    'التسجيل الجديد = guest حتى لو أرسل role=admin في metadata');
+
+  perform t.as_user(o1);
+  perform t.ok(public.is_admin() is false, 'مستخدم عادي: is_admin() = false');
+  perform t.ok(public.is_privileged_session() is false, 'جلسة API لمستخدم عادي ليست مميزة');
+  perform t.fails($q$ update public.profiles set role = 'admin' where id = '00000000-0000-0000-0000-0000000000c1' $q$,
+    'permission denied', 'الطبقة 1 (صلاحيات الأعمدة): لا تحديث للدور');
+  perform t.fails($q$ update public.profiles set verification_status = 'verified' where id = '00000000-0000-0000-0000-0000000000c1' $q$,
+    'permission denied', 'الطبقة 1: لا تحديث لحالة التوثيق');
+  perform t.ok((select count(*) from (select 1 from public.profiles where id <> o1) x) = 0,
+    'المستخدم لا يرى ملفات الآخرين غير المنشورين');
+
+  -- الطبقة الثانية: حتى لو مُنحت الصلاحية على العمود، يرفض التريجر الإصلاحي
+  perform t.as_super();
+  grant update (role, verification_status) on public.profiles to authenticated;
+  perform t.as_user(o1);
+  perform t.fails($q$ update public.profiles set role = 'admin' where id = '00000000-0000-0000-0000-0000000000c1' $q$,
+    'forbidden', 'الطبقة 2 (التريجر بعد الإصلاح): ترقية ذاتية إلى admin مرفوضة');
+  update public.profiles set role = 'owner' where id = '00000000-0000-0000-0000-0000000000c2';
+  perform t.as_super();
+  perform t.ok((select role from public.profiles where id = '00000000-0000-0000-0000-0000000000c2') = 'guest',
+    'لا ترقية حساب شخص آخر (RLS تتجاهل التحديث)');
+  perform t.as_user(o1);
+  perform t.fails($q$ update public.profiles set verification_status = 'verified' where id = '00000000-0000-0000-0000-0000000000c1' $q$,
+    'forbidden', 'الطبقة 2: التوثيق الذاتي مرفوض');
+  update public.profiles set role = 'owner' where id = o1;
+  perform t.ok((select role from public.profiles where id = o1) = 'owner', 'الترقية الذاتية المسموحة الوحيدة: guest → owner');
+  perform t.fails($q$ update public.profiles set role = 'admin' where id = '00000000-0000-0000-0000-0000000000c1' $q$,
+    'forbidden', 'من owner لا يمكن الترقية إلى admin');
+  perform t.as_super();
+  revoke update (role, verification_status) on public.profiles from authenticated;
+  update public.profiles set role = 'guest' where id = o1;
+
+  perform t.as_user(o1);
+  perform public.become_host('owner');
+  perform t.as_super();
+  perform t.ok((select role from public.profiles where id = o1) = 'owner', 'become_host() يعمل (guest → owner)');
+  perform t.ok((select count(*) from public.profiles where role = 'admin') = 1, 'يوجد مدير واحد فقط (المُعيَّن من SQL)');
+
+  perform t.as_user(a);
+  perform t.ok(public.is_admin() is true, 'المدير المعيَّن من SQL: is_admin() = true');
+end $$;
+
+-- =====================================================================
+-- 2) الزائر غير المسجل
+-- =====================================================================
+do $$
+declare
+  n int;
+begin
+  perform t.as_anon();
+  select count(*) into n from public.chalets;
+  perform t.ok(n = 1, 'الزائر يرى المنشور فقط (legacy-t1) ولا يرى المخفي');
+  perform t.fails($q$ select * from public.chalet_contacts $q$, 'permission denied', 'الزائر لا يقرأ جدول أرقام الملاك');
+  perform t.fails($q$ select * from public.subscriptions $q$, 'permission denied', 'الزائر لا يقرأ الاشتراكات');
+  perform t.fails($q$ insert into public.chalets (title, price_per_night, owner_name) values ('اختراق', 1, 'x') $q$,
+    'permission denied', 'الزائر لا ينشئ إعلانات');
+  perform t.fails($q$ update public.chalets set title = 'اختراق' $q$, 'permission denied', 'الزائر لا يعدّل إعلانات');
+  perform t.fails($q$ delete from public.chalets $q$, 'permission denied', 'الزائر لا يحذف إعلانات');
+  perform t.fails($q$ insert into public.subscriptions (owner_name, owner_phone, plan_id, plan_name, price, max_units, status)
+                      values ('x', '01011112222', 'enterprise', 'e', 1500, 20, 'active') $q$,
+    'permission denied', 'الزائر لا ينشئ اشتراكاً مفعّلاً بنفسه');
+  perform t.fails($q$ select public.request_subscription('starter', 'x/y.jpg') $q$, 'permission denied', 'الزائر لا يطلب اشتراكاً');
+  perform t.fails($q$ select public.admin_review_subscription('sub-legacy-t1', true) $q$, 'permission denied', 'الزائر لا يراجع اشتراكات');
+  perform t.fails($q$ select public.owner_plan('00000000-0000-0000-0000-0000000000c1') $q$, 'permission denied', 'دوال الباقة الداخلية غير مكشوفة');
+  select count(*) into n from public.plans;
+  perform t.ok(n = 4, 'الباقات مقروءة للجميع');
+
+  -- كشف رقم المالك
+  perform t.ok(public.reveal_listing_contact('legacy-t1') = '01099990000', 'كشف رقم إعلان منشور');
+  perform t.fails($q$ select public.reveal_listing_contact('legacy-t2') $q$, 'chalet_not_found', 'لا كشف لرقم إعلان مخفي');
+  perform t.fails($q$ select public.reveal_listing_contact('no-such') $q$, 'chalet_not_found', 'إعلان غير موجود');
+end $$;
+
+-- تحديد المعدل: 3 كشوف/ساعة لكل IP
+do $$
+begin
+  perform t.as_super();
+  update public.app_settings set value = '3' where key = 'contact_reveal_limit_per_hour';
+  delete from public.contact_reveals;
+
+  perform t.as_anon('1.1.1.1');
+  perform public.reveal_listing_contact('legacy-t1');
+  perform public.reveal_listing_contact('legacy-t1');
+  perform public.reveal_listing_contact('legacy-t1');
+  perform t.fails($q$ select public.reveal_listing_contact('legacy-t1') $q$, 'rate_limited', 'الكشف الرابع من نفس IP مرفوض (rate_limited)');
+
+  perform t.as_anon('2.2.2.2');
+  perform t.ok(public.reveal_listing_contact('legacy-t1') = '01099990000', 'IP مختلف لا يتأثر بحد غيره');
+
+  perform t.as_user('00000000-0000-0000-0000-0000000000c3');
+  perform t.ok(public.reveal_listing_contact('legacy-t1') = '01099990000', 'المستخدم المسجّل له عدّاد مستقل عن IP');
+
+  perform t.as_super();
+  update public.app_settings set value = '40' where key = 'contact_reveal_limit_per_hour';
+end $$;
+
+-- =====================================================================
+-- 3) المالك: الملكية، الأعمدة المحمية، الحد حسب الباقة
+-- =====================================================================
+do $$
+declare
+  o1 uuid := '00000000-0000-0000-0000-0000000000c1';
+  o2 uuid := '00000000-0000-0000-0000-0000000000c2';
+  l1 text; l2 text; r record;
+begin
+  perform t.as_user(o1);
+  l1 := t.listing('شاليه O1', true);   -- محاولة فرض owner_id=O2 وأعمدة محمية
+  insert into t.state values ('l1', l1);
+  perform t.as_super();
+  select * into r from public.chalets where id = l1;
+  perform t.ok(r.owner_id = o1, 'owner_id المُرسَل (مالك آخر) يُستبدل بمالك الجلسة');
+  perform t.ok(r.is_featured is false and r.featured is false, 'is_featured/featured المُرسَلة تُتجاهل (باقة مجانية)');
+  perform t.ok(r.rating = 0 and r.reviews_count = 0, 'rating/reviews_count المُرسَلة تُتجاهل');
+  perform t.ok(r.owner_verified is false and r.host_tier = 'free', 'owner_verified/host_tier المُرسَلة تُتجاهل');
+  perform t.ok(r.availability_status = 'active', 'بوابة التوثيق اختيارية افتراضياً: النشر المباشر لغير الموثق');
+
+  perform t.as_user(o1);
+  perform t.fails($q$ select t.listing('إعلان ثانٍ للباقة المجانية') $q$, 'quota_exceeded', 'الحد: باقة مجانية = وحدة واحدة');
+  perform t.fails($q$ select t.listing('إعلان موقوف ذاتياً', false, 'suspended') $q$, 'forbidden_status', 'لا يمكن للمالك إنشاء إعلان suspended');
+
+  -- تعديل الإعلان
+  update public.chalets set title = 'عنوان معدّل', is_featured = true, rating = 5, owner_id = o2, owner_verified = true where id = l1;
+  perform t.as_super();
+  select * into r from public.chalets where id = l1;
+  perform t.ok(r.title = 'عنوان معدّل', 'المالك يعدّل بيانات إعلانه');
+  perform t.ok(r.owner_id = o1 and r.is_featured is false and r.rating = 0 and r.owner_verified is false,
+    'تعديل الأعمدة المحمية (مالك/تمييز/تقييم/توثيق) يُتجاهل');
+  perform t.as_user(o1);
+  perform t.fails(format($q$ update public.chalets set availability_status = 'suspended' where id = %L $q$, l1),
+    'forbidden_status', 'المالك لا يوقف إعلانه بصفة إدارية');
+
+  -- مالك آخر لا يعدّل ولا يحذف
+  perform t.as_user(o2);
+  update public.chalets set title = 'اختراق' where id = l1;
+  delete from public.chalets where id = l1;
+  perform t.as_super();
+  perform t.ok((select title from public.chalets where id = l1) = 'عنوان معدّل', 'مالك آخر لا يعدّل إعلان غيره');
+  perform t.ok(exists (select 1 from public.chalets where id = l1), 'مالك آخر لا يحذف إعلان غيره');
+
+  -- الإعلان المخفي لا يراه إلا صاحبه
+  perform t.as_user(o1);
+  update public.chalets set availability_status = 'hidden' where id = l1;
+  perform t.ok((select count(*) from public.chalets where id = l1) = 1, 'المالك يرى إعلانه المخفي');
+  perform t.as_user(o2);
+  perform t.ok((select count(*) from public.chalets where id = l1) = 0, 'مالك آخر لا يرى المخفي');
+  perform t.as_anon();
+  perform t.ok((select count(*) from public.chalets where id = l1) = 0, 'الزائر لا يرى المخفي');
+  perform t.as_user(o1);
+  update public.chalets set availability_status = 'active' where id = l1;
+
+  -- حدود البيانات
+  perform t.as_user(o2);
+  perform t.fails($q$ select t.listing(repeat('ع', 200)) $q$, 'chalets_limits_chk', 'عنوان أطول من 150 حرفاً مرفوض');
+  perform t.fails($q$ insert into public.chalets (title, price_per_night, owner_name, images)
+                      values ('صور كثيرة', 100, 'x', array_fill('u'::text, array[21])) $q$,
+    'chalets_limits_chk', 'أكثر من 20 صورة مرفوض');
