index 0000000..e2634bd
--- /dev/null
+++ b/src/components/AuthForm.tsx
@@ -0,0 +1,219 @@
+import { useState } from 'react';
+import { KeyRound, Loader2, Mail, Phone, User } from 'lucide-react';
+import {
+  loadAuthSession,
+  requestPasswordReset,
+  signInWithEmail,
+  signUpWithEmail,
+} from '@/services/authService';
+import type { OwnerSession } from '@/types/chalet';
+
+type Mode = 'login' | 'register' | 'reset';
+
+interface AuthFormProps {
+  onAuthenticated: (session: OwnerSession) => void;
+  /** نص زر الإرسال في وضع الدخول */
+  loginLabel?: string;
+}
+
+const inputClass =
+  'h-11 w-full rounded-xl border border-stone-200/70 bg-[#FAF9F6] pl-3 pr-10 text-sm text-[#1F2937] focus:border-[#1E3A5F] focus:bg-white focus:outline-none';
+
+/**
+ * نموذج دخول/تسجيل/استعادة كلمة مرور عبر Supabase Auth.
+ * يُستخدم في بوابة المعلن وصفحة الباقات ولوحة الإدارة.
+ */
+export function AuthForm({ onAuthenticated, loginLabel = 'تسجيل الدخول' }: AuthFormProps) {
+  const [mode, setMode] = useState<Mode>('login');
+  const [name, setName] = useState('');
+  const [phone, setPhone] = useState('');
+  const [email, setEmail] = useState('');
+  const [password, setPassword] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [info, setInfo] = useState('');
+
+  const switchMode = (next: Mode) => {
+    setMode(next);
+    setError('');
+    setInfo('');
+  };
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError('');
+    setInfo('');
+    setBusy(true);
+    try {
+      if (mode === 'login') {
+        const res = await signInWithEmail(email, password);
+        if (res.error || !res.data) {
+          setError(res.error ?? 'تعذر تسجيل الدخول.');
+          return;
+        }
+        onAuthenticated(res.data);
+        return;
+      }
+
+      if (mode === 'register') {
+        const res = await signUpWithEmail({ name, email, password, phone });
+        if (res.error || !res.data) {
+          setError(res.error ?? 'تعذر إنشاء الحساب.');
+          return;
+        }
+        if (res.data.needsEmailConfirmation) {
+          setInfo('تم إنشاء حسابك. افتح الرابط المرسل إلى بريدك لتأكيده، ثم سجّل الدخول.');
+          setMode('login');
+          setPassword('');
+          return;
+        }
+        const session = await loadAuthSession();
+        if (session) onAuthenticated(session);
+        return;
+      }
+
+      const res = await requestPasswordReset(email);
+      if (res.error) {
+        setError(res.error);
+        return;
+      }
+      setInfo('أرسلنا رابط استعادة كلمة المرور إلى بريدك الإلكتروني.');
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const submitLabel =
+    mode === 'login' ? loginLabel : mode === 'register' ? 'إنشاء حساب' : 'إرسال رابط الاستعادة';
+
+  return (
+    <form onSubmit={handleSubmit} className="mt-6 space-y-4" noValidate>
+      {mode === 'register' && (
+        <>
+          <div>
+            <label htmlFor="auth-name" className="mb-1.5 block text-xs font-semibold text-slate-700">
+              الاسم بالكامل أو اسم المكتب العقاري
+            </label>
+            <div className="relative">
+              <User className="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
+              <input
+                id="auth-name"
+                type="text"
+                autoComplete="name"
+                required
+                value={name}
+                onChange={(e) => setName(e.target.value)}
+                placeholder="مثال: أ. كريم عبد الله"
+                className={inputClass}
+              />
+            </div>
+          </div>
+          <div>
+            <label htmlFor="auth-phone" className="mb-1.5 block text-xs font-semibold text-slate-700">
+              رقم الموبايل / واتساب (يظهر للمهتمين بإعلانك)
+            </label>
+            <div className="relative">
+              <Phone className="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
+              <input
+                id="auth-phone"
+                type="tel"
+                autoComplete="tel"
+                required
+                dir="ltr"
+                value={phone}
+                onChange={(e) => setPhone(e.target.value)}
+                placeholder="01012345678"
+                className={`${inputClass} text-right`}
+              />
+            </div>
+          </div>
+        </>
+      )}
+
+      <div>
+        <label htmlFor="auth-email" className="mb-1.5 block text-xs font-semibold text-slate-700">
+          البريد الإلكتروني
+        </label>
+        <div className="relative">
+          <Mail className="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
+          <input
+            id="auth-email"
+            type="email"
+            autoComplete="email"
+            required
+            dir="ltr"
+            value={email}
+            onChange={(e) => setEmail(e.target.value)}
+            placeholder="name@example.com"
+            className={`${inputClass} text-right`}
+          />
+        </div>
+      </div>
+
+      {mode !== 'reset' && (
+        <div>
+          <label htmlFor="auth-password" className="mb-1.5 block text-xs font-semibold text-slate-700">
+            كلمة المرور {mode === 'register' && '(8 أحرف على الأقل)'}
+          </label>
+          <div className="relative">
+            <KeyRound className="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
+            <input
+              id="auth-password"
+              type="password"
+              autoComplete={mode === 'login' ? 'current-password' : 'new-password'}
+              required
+              minLength={mode === 'register' ? 8 : undefined}
+              dir="ltr"
+              value={password}
+              onChange={(e) => setPassword(e.target.value)}
+              className={`${inputClass} text-right`}
+            />
+          </div>
+        </div>
+      )}
+
+      {error && (
+        <div
+          role="alert"
+          className="rounded-xl border border-red-200 bg-red-50 px-3.5 py-2.5 text-xs font-semibold text-red-700"
+        >
+          {error}
+        </div>
+      )}
+      {info && (
+        <div
+          role="status"
+          className="rounded-xl border border-emerald-200 bg-emerald-50 px-3.5 py-2.5 text-xs font-semibold text-emerald-800"
+        >
+          {info}
+        </div>
+      )}
+
+      <button
+        type="submit"
+        disabled={busy}
+        className="flex min-h-[48px] w-full items-center justify-center gap-2 rounded-xl bg-[#1E3A5F] px-5 py-3 text-sm font-bold text-white shadow-xs transition hover:bg-[#172E4D] disabled:opacity-60"
+      >
+        {busy && <Loader2 className="h-4 w-4 animate-spin" />}
+        <span>{submitLabel}</span>
+      </button>
+
+      <div className="flex flex-wrap items-center justify-between gap-2 text-xs font-semibold text-[#1E3A5F]">
+        {mode === 'login' ? (
+          <>
+            <button type="button" onClick={() => switchMode('register')} className="hover:underline">
+              ليس لديك حساب؟ أنشئ حساباً
+            </button>
+            <button type="button" onClick={() => switchMode('reset')} className="hover:underline">
+              نسيت كلمة المرور؟
+            </button>
+          </>
+        ) : (
+          <button type="button" onClick={() => switchMode('login')} className="hover:underline">
+            لديك حساب؟ سجّل الدخول
+          </button>
+        )}
+      </div>
+    </form>
+  );
+}
