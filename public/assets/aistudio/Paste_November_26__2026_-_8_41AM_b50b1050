+-- مزامنة شارة "مميز" مع باقة المالك الحالية (داخلي؛ يستدعيه المدير عبر RPC أو الجدولة)
+create or replace function public.refresh_owner_featured(p_owner uuid)
+returns void
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_eligible boolean := public.owner_featured_eligible(p_owner);
+begin
+  update public.chalets c
+     set is_featured = v_eligible
+   where c.owner_id = p_owner
+     and c.is_featured is distinct from v_eligible;
+end;
+$$;
+revoke all on function public.refresh_owner_featured(uuid) from public, anon, authenticated;
