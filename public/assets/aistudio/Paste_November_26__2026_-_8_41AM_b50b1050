+-- =====================================================================
+-- AgzStay — 006_secure_v2.sql  (إصلاح الأمان لمخطط V2)
+--
+-- يعالج مشكلتين حرجتين وجدتا في الترحيلات 001–005:
+--
+--  1) ثغرة تصعيد الصلاحيات: الدوال التي تحمي الدور (role) والنشر والحجوزات
+--     كانت تفحص current_user داخل دوال SECURITY DEFINER، وقيمته فيها دائماً
+--     مالك الدالة (postgres) فيتخطى الفحص كل المستخدمين. النتيجة: أي مستخدم
+--     مسجّل يستطيع تحويل نفسه إلى admin بتحديث صف profiles الخاص به.
+--     الإصلاح: دالة is_privileged_session() تعتمد على current_setting('role')
+--     الذي يضبطه PostgREST (anon / authenticated / service_role).
+--
+--  2) الترحيل 005 فتح قاعدة البيانات: سياسات using (true) للقراءة والكتابة والحذف
+--     على chalets و subscriptions، وباكتات رفع مفتوحة، وإيصالات عامة.
+--     الإصلاح: ملكية الإعلانات بـ auth.uid()، وأرقام الملاك في جدول خاص مع
+--     دالة كشف محدودة المعدل، واشتراكات لا تُفعَّل إلا من المدير عبر RPC،
+--     وحدود الباقات والشارة المميزة تُفرض في قاعدة البيانات.
+--
+-- ⚠️ هذا الترحيل يغيّر عقد الواجهة (انظر PROMPT_SECURITY_FIXES.md):
+--    - أُزيل العمود chalets.owner_phone (ينتقل إلى chalet_contacts الخاص).
+--    - الكتابة تتطلب تسجيل دخول Supabase Auth (لا جلسة هاتف محلية).
+--    - الاشتراكات عبر RPC: request_subscription / admin_review_subscription.
+--    اختبره على مشروع staging ونفّذه مع نشر الواجهة الجديدة معاً.
+--
+-- يُشغَّل بعد 001–005. آمن لإعادة التشغيل (idempotent) قدر الإمكان.
+-- =====================================================================
+
+begin;
+
+-- ---------------------------------------------------------------------
+-- 0) هل الجلسة "مميزة"؟ (SQL Editor / service_role / مدير)
+-- ---------------------------------------------------------------------
+-- ملاحظة: current_setting('role') هو ما يضبطه PostgREST (SET LOCAL ROLE)، ولا يتغير
+-- داخل دوال SECURITY DEFINER بعكس current_user. من SQL Editor تكون قيمته 'none'.
+create or replace function public.is_privileged_session()
+returns boolean
+language sql
+stable
+security definer
+set search_path = public, extensions
+as $$
+  select coalesce(current_setting('role', true), 'none')
+           in ('none', 'postgres', 'supabase_admin', 'service_role')
+         or public.is_admin();
+$$;
+
+revoke all on function public.is_privileged_session() from public;
+grant execute on function public.is_privileged_session() to anon, authenticated;
+
+-- ---------------------------------------------------------------------
+-- 1) إصلاح الدوال التي كانت تفحص current_user (يُستخرج نصها من 002/003 مع الاستبدال)
+-- ---------------------------------------------------------------------
+-- حماية الدور وحالة التوثيق في profiles
+--  - المسموح ذاتياً فقط: guest → owner لحسابه هو (become_host)، ولا admin أبداً.
+--  - pg_trigger_depth() > 1 يعني تحديثاً داخلياً من تريجر آخر (مثل مزامنة التوثيق).
+create or replace function public.prevent_profile_role_self_change()
+returns trigger
+language plpgsql
+security definer
+set search_path = public, extensions
+as $$
+begin
+  if public.is_privileged_session() or pg_trigger_depth() > 1 then
+    return new;
+  end if;
+
+  if new.role is distinct from old.role then
+    if not (old.role = 'guest' and new.role = 'owner' and old.id = auth.uid()) then
+      raise exception 'forbidden';
+    end if;
+  end if;
+
+  if new.verification_status is distinct from old.verification_status then
+    raise exception 'forbidden';
+  end if;
+
+  return new;
+end;
+$$;
+
+-- طبقة ثانية: لا يستطيع المستخدم تحديث إلا أعمدته الآمنة عبر الـ API
+revoke update on public.profiles from anon, authenticated;
+grant update (name, phone, advertiser_type) on public.profiles to authenticated;
+
+
+-- handle_owner_verification_rules (أصلها في 003_profile_host_upgrade.sql؛ استُبدل فحص current_user بـ is_privileged_session())
+create or replace function public.handle_owner_verification_rules()
+returns trigger
+language plpgsql
+security definer
+set search_path = public, extensions
+as $$
+begin
+  if tg_op = 'INSERT' then
+    if not public.is_admin() and not public.is_privileged_session() then
+      new.status := 'pending';
+      new.reviewed_at := null;
+      new.rejection_reason := null;
+      new.reviewed_by := null;
+    end if;
+
+    update public.profiles
+    set verification_status = new.status
+    where id = new.owner_id;
+
+    return new;
+  end if;
+
+  if tg_op = 'UPDATE' then
+    if not public.is_admin() and not public.is_privileged_session() then
+      if old.owner_id = auth.uid() and new.owner_id = auth.uid() then
+        new.status := 'pending';
+        new.reviewed_at := null;
+        new.rejection_reason := null;
+        new.reviewed_by := null;
+        new.submitted_at := now();
+
+        update public.profiles
+        set verification_status = 'pending'
+        where id = new.owner_id;
+
+        return new;
+      end if;
+      raise exception 'forbidden';
+    end if;
+
+    update public.profiles
+    set verification_status = new.status
+    where id = new.owner_id;
+
+    if new.status = 'verified' then
+      new.reviewed_at := now();
+      new.rejection_reason := null;
+      update public.profiles
+      set role = case when role = 'guest' then 'owner' else role end,
+          verification_status = 'verified'
+      where id = new.owner_id;
+
+      update public.chalets
+      set owner_verified = true,
+          availability_status = case
+            when availability_status = 'pending_review' then 'active'
+            else availability_status
+          end
+      where owner_id = new.owner_id;
+    elsif new.status = 'unverified' then
+      new.reviewed_at := now();
+      update public.chalets
+      set owner_verified = false,
+          availability_status = case
+            when availability_status = 'active' then 'pending_review'
+            else availability_status
+          end
+      where owner_id = new.owner_id;
+    end if;
+  end if;
+
+  return new;
+end;
+$$;
+
+
+-- ملاحظة: الدالة enforce_booking_update_rules (الحجوزات) فيها نفس النمط (current_user)،
+-- لكنها غير مستخدمة في V2 ولم تُغيَّر هنا. راجعها قبل إعادة تفعيل الحجز الداخلي.
+
+-- ---------------------------------------------------------------------
+-- 2) إعدادات التطبيق (يضبطها المدير من SQL Editor فقط)
+-- ---------------------------------------------------------------------
+create table if not exists public.app_settings (
+  key        text primary key,
+  value      text not null,
+  updated_at timestamptz not null default now()
+);
+
+insert into public.app_settings (key, value) values
+  ('require_verified_to_publish', 'false'),   -- true = الإعلان الجديد لغير الموثق يذهب لـ pending_review
+  ('contact_reveal_limit_per_hour', '40')     -- حد كشف أرقام الملاك لكل زائر/ساعة
+on conflict (key) do nothing;
+
+alter table public.app_settings enable row level security;   -- بلا سياسات = لا وصول من الـ API
+revoke all on public.app_settings from anon, authenticated;
+
+create or replace function public.app_setting(p_key text, p_default text default null)
+returns text
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select coalesce((select s.value from public.app_settings s where s.key = p_key), p_default);
+$$;
+revoke all on function public.app_setting(text, text) from public, anon, authenticated;
+
+-- ---------------------------------------------------------------------
+-- 3) الباقات (مصدر الحقيقة في قاعدة البيانات، لا في الواجهة)
+-- ---------------------------------------------------------------------
+create table if not exists public.plans (
+  id                text primary key,
+  name              text    not null,
+  price             numeric not null check (price >= 0),
+  max_units         integer not null check (max_units >= 1),
+  featured_eligible boolean not null default false,
+  duration_days     integer not null default 30 check (duration_days > 0),  -- افتراض: اشتراك شهري
+  sort_order        integer not null default 0
+);
