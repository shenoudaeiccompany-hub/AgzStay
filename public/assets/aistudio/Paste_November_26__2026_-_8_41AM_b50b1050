+    phone: String(row.phone ?? '') || String(user.user_metadata?.phone ?? ''),
+    role: asRole(row.role),
+  };
+}
+
+export async function signUpWithEmail(input: {
+  name: string;
+  email: string;
+  password: string;
+  phone: string;
+}): Promise<AuthResult<{ needsEmailConfirmation: boolean }>> {
+  const name = input.name.trim();
+  const email = input.email.trim().toLowerCase();
+  const phone = normalizeEgyptianPhone(input.phone);
+
+  if (name.length < 3) return { data: null, error: 'يرجى إدخال الاسم ثلاثياً على الأقل.' };
+  if (!EMAIL_RE.test(email)) return { data: null, error: 'البريد الإلكتروني غير صحيح.' };
+  if (input.password.length < 8) {
+    return { data: null, error: 'كلمة المرور يجب ألا تقل عن 8 أحرف.' };
+  }
+  if (!/^01[0125][0-9]{8}$/.test(phone)) {
+    return { data: null, error: 'يرجى إدخال رقم موبايل مصري صحيح (مثال: 01012345678).' };
+  }
+
+  try {
+    const sb = requireSupabase();
+    // لا نرسل role: الدور يُحدَّد في الخادم دائماً guest
+    const { data, error } = await sb.auth.signUp({
+      email,
+      password: input.password,
+      options: { data: { name, phone }, emailRedirectTo: window.location.origin },
+    });
+    if (error) return { data: null, error: formatSupabaseError(error, 'تعذر إنشاء الحساب.') };
+
+    // عند تفعيل تأكيد البريد يعيد Supabase مستخدماً بلا هويات إن كان البريد مسجلاً مسبقاً
+    if (data.user && Array.isArray(data.user.identities) && data.user.identities.length === 0) {
+      return { data: null, error: 'هذا البريد مسجّل بالفعل، سجّل الدخول بدلاً من إنشاء حساب.' };
+    }
+    return { data: { needsEmailConfirmation: !data.session }, error: null };
+  } catch (err) {
+    return { data: null, error: formatSupabaseError(err, 'تعذر إنشاء الحساب.') };
+  }
+}
+
+export async function signInWithEmail(
+  email: string,
+  password: string
+): Promise<AuthResult<OwnerSession>> {
+  if (!EMAIL_RE.test(email.trim())) return { data: null, error: 'البريد الإلكتروني غير صحيح.' };
+  try {
+    const sb = requireSupabase();
+    const { error } = await sb.auth.signInWithPassword({ email: email.trim().toLowerCase(), password });
+    if (error) return { data: null, error: formatSupabaseError(error, 'تعذر تسجيل الدخول.') };
+    const session = await loadAuthSession();
+    if (!session) return { data: null, error: 'تعذر قراءة بيانات الحساب بعد تسجيل الدخول.' };
+    return { data: session, error: null };
+  } catch (err) {
+    return { data: null, error: formatSupabaseError(err, 'تعذر تسجيل الدخول.') };
+  }
+}
+
+export async function signOutUser(): Promise<void> {
+  if (!supabase) return;
+  try {
+    await supabase.auth.signOut();
+  } catch {
+    // فشل الخروج البعيد لا يمنع تنظيف الجلسة محلياً
+  }
+}
+
+export async function requestPasswordReset(email: string): Promise<AuthResult<true>> {
+  if (!EMAIL_RE.test(email.trim())) return { data: null, error: 'البريد الإلكتروني غير صحيح.' };
+  try {
+    const { error } = await requireSupabase().auth.resetPasswordForEmail(email.trim().toLowerCase(), {
+      redirectTo: window.location.origin,
+    });
+    if (error) return { data: null, error: formatSupabaseError(error, 'تعذر إرسال رابط الاستعادة.') };
+    return { data: true, error: null };
+  } catch (err) {
+    return { data: null, error: formatSupabaseError(err, 'تعذر إرسال رابط الاستعادة.') };
+  }
+}
+
+/** يحدّث اسم المستخدم وهاتفه (الأعمدة الوحيدة المسموح بتعديلها من العميل) */
+export async function updateMyProfile(input: {
+  userId: string;
+  name?: string;
+  phone?: string;
+}): Promise<AuthResult<true>> {
+  const patch: Record<string, string> = {};
+  if (input.name !== undefined) {
+    if (input.name.trim().length < 3) return { data: null, error: 'يرجى إدخال الاسم ثلاثياً على الأقل.' };
+    patch.name = input.name.trim();
+  }
+  if (input.phone !== undefined) {
+    const phone = normalizeEgyptianPhone(input.phone);
+    if (!/^01[0125][0-9]{8}$/.test(phone)) {
+      return { data: null, error: 'يرجى إدخال رقم موبايل مصري صحيح (مثال: 01012345678).' };
+    }
+    patch.phone = phone;
+  }
+  try {
+    const { error } = await requireSupabase().from('profiles').update(patch).eq('id', input.userId);
+    if (error) return { data: null, error: formatSupabaseError(error, 'تعذر تحديث بياناتك.') };
+    return { data: true, error: null };
+  } catch (err) {
+    return { data: null, error: formatSupabaseError(err, 'تعذر تحديث بياناتك.') };
+  }
+}
+
+/** يستمع لتغيّر حالة الدخول ويعيد الجلسة الكاملة. يعيد دالة إلغاء الاشتراك. */
+export function subscribeToAuth(callback: (session: OwnerSession | null) => void): () => void {
+  if (!supabase) return () => undefined;
+  const { data } = supabase.auth.onAuthStateChange(() => {
+    // لا نستدعي Supabase مباشرة داخل المستمع (قد يسبب تعليقاً)؛ نؤجل التحميل
+    window.setTimeout(() => {
+      void loadAuthSession().then(callback);
+    }, 0);
+  });
+  return () => data.subscription.unsubscribe();
+}
